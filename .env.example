# Copia este archivo como .env.local y completa los valores.
# .env.local está en .gitignore: nunca subas claves reales al repositorio.

# Supabase — Dashboard > Settings > API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Mercado Pago — https://www.mercadopago.com.mx/developers (usa credenciales de PRUEBA en desarrollo)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Pagos en efectivo (OXXO) y transferencias lentas: se confirman fuera de la
# ventana de reserva de 5 minutos. Desactivados por defecto.
ALLOW_CASH_PAYMENTS=false
# Reembolso automático cuando un pago se confirma después de que otro negocio
# pagó más por la misma posición.
AUTO_REFUND_OUTBID=true

# URL pública de la aplicación (en producción debe ser HTTPS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contraseña del panel /admin (mínimo 12 caracteres)
ADMIN_PASSWORD=
